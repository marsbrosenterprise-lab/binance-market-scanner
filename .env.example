# Application
APP_NAME=binance-market-scanner
APP_ENV=development
APP_MODE=read_only_testnet
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://scanner:scanner_dev_password@localhost:5432/scanner
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner_dev_password
DATABASE_URL_DOCKER=postgresql+asyncpg://scanner:scanner_dev_password@postgres:5432/scanner

# Use either the legacy Spot Testnet or the separate Spot Demo environment.
BINANCE_REST_BASE_URL=https://testnet.binance.vision
BINANCE_WS_BASE_URL=wss://stream.testnet.binance.vision/ws

# Credentials are intentionally blank. Supply them only through a secret manager
# or protected environment configuration after the read-only foundation is reviewed.
BINANCE_API_KEY=
BINANCE_API_SECRET=
APPROVAL_TOKEN=
OPERATOR_ID=local-operator

# Private MCP access is separate from the dashboard approval token. These are
# placeholders for a selected OAuth provider; never copy secrets into Git.
MCP_AUTH_TOKEN=
MCP_AUTH_MODE=introspection
MCP_AUTH_ISSUER_URL=https://YOUR-OAUTH-ISSUER.example/realms/binance
MCP_RESOURCE_URL=https://YOUR-MCP-RESOURCE.example/mcp
MCP_REQUIRED_SCOPE=binance:read
MCP_DRAFT_SCOPE=binance:draft
# Local-only static token scopes; production OAuth scope grants come from the provider.
MCP_STATIC_SCOPES=binance:read binance:draft
MCP_INTROSPECTION_URL=https://YOUR-OAUTH-ISSUER.example/realms/binance/protocol/openid-connect/token/introspect
MCP_INTROSPECTION_CLIENT_ID=resource-server-introspection
MCP_INTROSPECTION_CLIENT_SECRET=REPLACE_LOCALLY
MCP_MAX_REQUESTS_PER_MINUTE=60

# Live Binance Convert is isolated from Spot trading and disabled by default.
LIVE_CONVERT_ENABLED=false
LIVE_CONVERT_AUTO_EXECUTION_ENABLED=false
LIVE_CONVERT_REST_BASE_URL=https://api.binance.com
LIVE_CONVERT_API_KEY=
LIVE_CONVERT_API_SECRET=
LIVE_CONVERT_ALLOWED_FROM_ASSETS=USDT,XRP
LIVE_CONVERT_ALLOWED_TO_ASSETS=BTC,ETH,XRP
LIVE_CONVERT_MAX_FROM_AMOUNT=10

# Safety defaults
TRADING_ENABLED=false
WITHDRAWALS_ENABLED=false
PROPOSAL_EXPIRY_SECONDS=300
INGEST_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
INGEST_INTERVAL=1m
INGEST_BACKFILL_LIMIT=500
SIGNAL_SCAN_SECONDS=1
MARKET_DATA_MAX_AGE_SECONDS=10
MAX_ORDER_NOTIONAL=10
MARKET_DATA_ENVIRONMENT=sandbox
