# Application
APP_NAME=binance-market-scanner
APP_ENV=development
APP_MODE=read_only_testnet
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://scanner:scanner_dev_password@localhost:5432/scanner

# Use either the legacy Spot Testnet or the separate Spot Demo environment.
BINANCE_REST_BASE_URL=https://testnet.binance.vision
BINANCE_WS_BASE_URL=wss://stream.testnet.binance.vision/ws

# Credentials are intentionally blank. Supply them only through a secret manager
# or protected environment configuration after the read-only foundation is reviewed.
BINANCE_API_KEY=
BINANCE_API_SECRET=
APPROVAL_TOKEN=
OPERATOR_ID=local-operator

# Live Binance Convert is isolated from Spot trading and disabled by default.
LIVE_CONVERT_ENABLED=false
LIVE_CONVERT_AUTO_EXECUTION_ENABLED=false
LIVE_CONVERT_REST_BASE_URL=https://api.binance.com
LIVE_CONVERT_API_KEY=
LIVE_CONVERT_API_SECRET=
LIVE_CONVERT_ALLOWED_FROM_ASSETS=USDT,XRP
LIVE_CONVERT_ALLOWED_TO_ASSETS=BTC,ETH,XRP
LIVE_CONVERT_MAX_FROM_AMOUNT=10

# Safety defaults
TRADING_ENABLED=false
WITHDRAWALS_ENABLED=false
PROPOSAL_EXPIRY_SECONDS=300
INGEST_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
INGEST_INTERVAL=1m
INGEST_BACKFILL_LIMIT=500
SIGNAL_SCAN_SECONDS=1
MAX_ORDER_NOTIONAL=10
